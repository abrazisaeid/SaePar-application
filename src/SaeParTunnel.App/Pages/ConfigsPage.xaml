<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="True" x:Class="SaeParTunnel.App.Pages.ConfigsPage"
             x:Name="ConfigsRoot"
             Title="کانفیگ‌ها">
    <Grid Padding="14">
        <ScrollView IsVisible="{Binding ShowConfigWorkflow}">
            <VerticalStackLayout Spacing="12"
                                 Padding="0,0,0,18"
                                 MaximumWidthRequest="900">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="مدیریت کانفیگ‌ها" Style="{StaticResource TitleLabel}" />
                        <Label Text="{Binding ConfigFlowNextStep}" Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <ActivityIndicator Grid.Column="1"
                                       IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Accent}"
                                       WidthRequest="32"
                                       HeightRequest="32"
                                       VerticalOptions="Center" />
                </Grid>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="{Binding ConfigModeText}" FontAttributes="Bold" FontSize="17" />
                            <Label Text="{Binding ConfigModeHint}" Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding QuickMode}"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="وضعیت کلی" FontAttributes="Bold" FontSize="17" />
                                <Label Text="{Binding ConfigFlowHealthSummary}" Style="{StaticResource SubtleLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding HealthyProfilesCountText}"
                                   TextColor="{StaticResource Success}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding StatusMessage}"
                               TextColor="{StaticResource Accent}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="پیشنهاد هوشمند" FontAttributes="Bold" FontSize="18" />
                                <Label Text="{Binding RecommendedProfileScoreText}" Style="{StaticResource SubtleLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding RecommendedProfileName}"
                                   TextColor="{StaticResource Success}"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding RecommendedProfileDetails}" Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8"
                              IsVisible="{Binding HasRecommendedProfile}">
                            <Button Grid.Column="0"
                                    Text="اتصال سریع به بهترین گزینه"
                                    Command="{Binding ConnectBestCommand}"
                                    IsEnabled="{Binding CanStartConnection}"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button Grid.Column="1"
                                    Text="اشتراک"
                                    Command="{Binding ShareProfileCommand}"
                                    CommandParameter="{Binding RecommendedHealthyProfile}"
                                    IsEnabled="{Binding IsNotBusy}" />
                        </Grid>
                        <Label Text="بعد از تست سلامت، برنامه بهترین سرور را بر اساس امتیاز، Ping، تازگی تست و شکست‌های قبلی انتخاب می‌کند."
                               Style="{StaticResource SubtleLabel}"
                               IsVisible="{Binding NoRecommendedProfile}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="1. دریافت" FontAttributes="Bold" FontSize="17" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="منابع Subscription" FontAttributes="Bold" />
                                <Label Text="{Binding SubscriptionSummaryText}" Style="{StaticResource SubtleLabel}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="دریافت از همه"
                                    Command="{Binding GetConfigCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource PrimaryButton}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SubscriptionSources}"
                                             Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="8" Padding="0,6">
                                        <BoxView HeightRequest="1" Opacity="0.14" />
                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="8">
                                            <Button Grid.Column="0"
                                                    Text="{Binding ExpansionGlyph}"
                                                    Command="{Binding BindingContext.ToggleSubscriptionCommand, Source={x:Reference ConfigsRoot}}"
                                                    CommandParameter="{Binding .}"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="0"
                                                    FontSize="18"
                                                    ToolTipProperties.Text="باز یا بسته کردن جزئیات منبع"
                                                    SemanticProperties.Description="باز یا بسته کردن جزئیات منبع" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                                <Label Text="{Binding StateText}"
                                                       Style="{StaticResource SubtleLabel}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                            </VerticalStackLayout>
                                            <Switch Grid.Column="2"
                                                    IsToggled="{Binding IsEnabled}"
                                                    IsEnabled="{Binding BindingContext.IsNotBusy, Source={x:Reference ConfigsRoot}}"
                                                    VerticalOptions="Center"
                                                    SemanticProperties.Description="فعال بودن منبع در دریافت گروهی" />
                                        </Grid>

                                        <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                                             Spacing="7"
                                                             Padding="52,0,0,2">
                                            <Label Text="{Binding Url}"
                                                   FlowDirection="LeftToRight"
                                                   HorizontalTextAlignment="Start"
                                                   FontSize="12"
                                                   LineBreakMode="MiddleTruncation"
                                                   MaxLines="2" />
                                            <Label Text="{Binding LastFetchedText}"
                                                   Style="{StaticResource SubtleLabel}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Button Grid.Column="0"
                                                        Text="دریافت از این منبع"
                                                        Command="{Binding BindingContext.FetchSubscriptionCommand, Source={x:Reference ConfigsRoot}}"
                                                        CommandParameter="{Binding .}"
                                                        IsEnabled="{Binding BindingContext.IsNotBusy, Source={x:Reference ConfigsRoot}}" />
                                                <Button Grid.Column="1"
                                                        Text="حذف"
                                                        Command="{Binding BindingContext.RemoveSubscriptionCommand, Source={x:Reference ConfigsRoot}}"
                                                        CommandParameter="{Binding .}"
                                                        IsEnabled="{Binding BindingContext.IsNotBusy, Source={x:Reference ConfigsRoot}}"
                                                        IsVisible="{Binding CanRemove}"
                                                        Style="{StaticResource DangerButton}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Opacity="0.14" />
                        <Grid ColumnDefinitions="*,44" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="افزودن Subscription شخصی" FontAttributes="Bold" />
                                <Label Text="نام دلخواه و لینک HTTPS اشتراک را وارد کن." Style="{StaticResource SubtleLabel}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="{Binding SubscriptionEditorGlyph}"
                                    Command="{Binding ToggleSubscriptionEditorCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0"
                                    FontSize="20"
                                    ToolTipProperties.Text="افزودن منبع اشتراک"
                                    SemanticProperties.Description="باز یا بسته کردن فرم افزودن اشتراک" />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding IsSubscriptionEditorExpanded}" Spacing="8">
                            <Entry Text="{Binding NewSubscriptionName}"
                                   Placeholder="نام منبع، اختیاری" />
                            <Entry Text="{Binding NewSubscriptionUrl}"
                                   Placeholder="https://example.com/subscription"
                                   FlowDirection="LeftToRight"
                                   Keyboard="Url" />
                            <Button Text="افزودن منبع"
                                    Command="{Binding AddSubscriptionCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource PrimaryButton}" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Opacity="0.14" />
                        <Label Text="یا لینک‌های کانفیگ را مستقیماً از Clipboard وارد کن." Style="{StaticResource SubtleLabel}" />
                        <Button Text="افزودن از Clipboard"
                                Command="{Binding ImportClipboardCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="9">
                        <Label Text="2. تست سلامت" FontAttributes="Bold" FontSize="17" />
                        <Label Text="{Binding PrimaryConfigFlowHint}" Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                        <Button Text="یافتن سرورهای سالم"
                                Command="{Binding TestFilteredCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Text="تست انتخاب‌شده‌ها"
                                Command="{Binding TestSelectedCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding IsTesting}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="در حال تست سلامت" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding ProgressLabel}" Style="{StaticResource SubtleLabel}" />
                        </Grid>
                        <ProgressBar Progress="{Binding ProgressFraction}" ProgressColor="{StaticResource Accent}" />
                        <Label Text="{Binding TestGoalMessage}" Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                        <Label Text="{Binding ProgressHealthyLabel}" TextColor="{StaticResource Success}" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{Binding ProgressSpeed}" Style="{StaticResource SubtleLabel}" />
                            <Label Grid.Column="1" Text="{Binding ProgressEta}" Style="{StaticResource SubtleLabel}" HorizontalTextAlignment="End" />
                        </Grid>
                        <Button Text="توقف تست"
                                Command="{Binding CancelTestCommand}"
                                Style="{StaticResource DangerButton}" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="نمایش فهرست و فیلترهای پیشرفته"
                        Command="{Binding ToggleAdvancedConfigToolsCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding ShowAdvancedConfigTools}"
              RowDefinitions="Auto,*"
              RowSpacing="10"
              MaximumWidthRequest="1000">
            <VerticalStackLayout Grid.Row="0" Spacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="فهرست پیشرفته کانفیگ‌ها" FontAttributes="Bold" FontSize="20" />
                        <Label Text="{Binding VisibleProfilesLabel}" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                    <ActivityIndicator Grid.Column="1"
                                       IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Accent}"
                                       WidthRequest="28"
                                       HeightRequest="28"
                                       VerticalOptions="Center" />
                    <Button Grid.Column="2"
                            Text="بستن"
                            Command="{Binding ToggleAdvancedConfigToolsCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            VerticalOptions="Center" />
                </Grid>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <SearchBar Placeholder="نام، سرور یا منبع را جستجو کن..."
                                   Text="{Binding SearchText}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <Picker Grid.Row="0" Grid.Column="0"
                                    Title="وضعیت"
                                    ItemsSource="{Binding StatusFilters}"
                                    SelectedItem="{Binding StatusFilter}" />
                            <Picker Grid.Row="0" Grid.Column="1"
                                    Title="پروتکل"
                                    ItemsSource="{Binding ProtocolFilters}"
                                    SelectedItem="{Binding ProtocolFilter}" />
                            <Picker Grid.Row="1" Grid.ColumnSpan="2"
                                    Title="مرتب‌سازی"
                                    ItemsSource="{Binding SortOptions}"
                                    SelectedItem="{Binding SortOption}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Text="انتخاب همه"
                                    Command="{Binding SelectVisibleCommand}"
                                    IsEnabled="{Binding IsNotBusy}" />
                            <Button Grid.Column="1"
                                    Text="لغو انتخاب"
                                    Command="{Binding ClearSelectionCommand}"
                                    IsEnabled="{Binding IsNotBusy}" />
                            <Button Grid.Column="2"
                                    Text="حذف فیلترها"
                                    Command="{Binding ResetFiltersCommand}"
                                    IsEnabled="{Binding IsNotBusy}" />
                        </Grid>
                        <Button Text="تست کانفیگ‌های انتخاب‌شده"
                                Command="{Binding TestSelectedCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource PrimaryButton}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding IsTesting}" Padding="12">
                    <VerticalStackLayout Spacing="7">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="در حال تست سلامت" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding ProgressLabel}" Style="{StaticResource SubtleLabel}" />
                        </Grid>
                        <ProgressBar Progress="{Binding ProgressFraction}" ProgressColor="{StaticResource Accent}" />
                        <Label Text="{Binding ProgressHealthyLabel}" TextColor="{StaticResource Success}" FontAttributes="Bold" />
                        <Button Text="توقف تست"
                                Command="{Binding CancelTestCommand}"
                                Style="{StaticResource DangerButton}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding FilteredProfiles}"
                            SelectionMode="None"
                            ItemsUpdatingScrollMode="KeepScrollOffset">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20" Spacing="6" HorizontalOptions="Center">
                        <Label Text="کانفیگی برای نمایش نیست" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="کانفیگ یا فیلتر فعالی وجود ندارد." Style="{StaticResource SubtleLabel}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,4" Padding="12">
                            <VerticalStackLayout Spacing="5">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelectedForTest}"
                                              VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding ProtocolText}" TextColor="{StaticResource Accent}" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding DisplayName}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding QualityText}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding Endpoint}" Style="{StaticResource SubtleLabel}" LineBreakMode="TailTruncation" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="{Binding HealthText}" Style="{StaticResource SubtleLabel}" />
                                    <Label Grid.Column="1" Text="{Binding Security}" Style="{StaticResource SubtleLabel}" />
                                    <Label Grid.Column="2" Text="{Binding LatencyText}" Style="{StaticResource SubtleLabel}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding QualitySummaryText}"
                                           Style="{StaticResource SubtleLabel}"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="1"
                                            Text="اشتراک"
                                            Command="{Binding BindingContext.ShareProfileCommand, Source={x:Reference ConfigsRoot}}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding BindingContext.IsNotBusy, Source={x:Reference ConfigsRoot}}"
                                            Padding="12,7" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,10,0,18" Spacing="6">
                        <Button Text="نمایش موارد بعدی"
                                Command="{Binding LoadMoreCommand}"
                                IsVisible="{Binding HasMoreProfiles}" />
                        <Label Text="{Binding VisibleProfilesLabel}"
                               Style="{StaticResource SubtleLabel}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
