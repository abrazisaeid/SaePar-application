<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SaeParTunnel.App.Pages.DiagnosticsPage"
             Title="عیب‌یابی">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="12" MaximumWidthRequest="900">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="عیب‌یابی" Style="{StaticResource TitleLabel}" />
                    <Label Text="{Binding ReleaseVersionText}" Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="1"
                                   IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Accent}"
                                   WidthRequest="32"
                                   HeightRequest="32"
                                   VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding ConnectionBadgeText}" FontAttributes="Bold" FontSize="18" />
                            <Label Text="{Binding RuntimeSummaryText}" Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding BackendTitle}"
                               Style="{StaticResource SubtleLabel}"
                               VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding ConnectionStatusMessage}" LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="تست اتصال فعلی"
                                Command="{Binding DiagnoseConnectionCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                        <Button Grid.Column="1"
                                Text="تازه‌سازی گزارش"
                                Command="{Binding RefreshDiagnosticsCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="گزارش پشتیبانی" FontAttributes="Bold" FontSize="18" />
                        <Button Grid.Column="1"
                                Text="کپی"
                                Command="{Binding CopyDiagnosticsCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </Grid>
                    <Label Text="{Binding DiagnosticsReport}"
                           FontFamily="monospace"
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           FlowDirection="LeftToRight" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
