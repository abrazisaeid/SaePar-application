<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaeParTunnel.App.ViewModels" x:DataType="vm:MainViewModel" x:Class="SaeParTunnel.App.Pages.SettingsPage" Title="پیشرفته">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="600">
            <Label Text="تنظیمات پیشرفته" Style="{StaticResource TitleLabel}" />
            <Label Text="برای استفادهٔ روزمره نیازی به تغییر این گزینه‌ها نیست." Style="{StaticResource SubtleLabel}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="مدیریت" FontSize="19" FontAttributes="Bold" />
                    <Button Text="سرورها و منابع" Clicked="OpenAdvancedPage" CommandParameter="advanced-configs" IsEnabled="{Binding IsNotBusy}" />
                    <Button Text="سایت‌های ایرانی و مسیر VPN" Clicked="OpenAdvancedPage" CommandParameter="advanced-whitelist" IsEnabled="{Binding IsNotBusy}" />
                    <Button Text="عیب‌یابی اتصال" Clicked="OpenAdvancedPage" CommandParameter="advanced-diagnostics" IsEnabled="{Binding IsNotBusy}" />
                    <Button Text="تنظیمات VPN اندروید" Command="{Binding OpenAndroidVpnSettingsCommand}" IsVisible="{Binding IsAndroid}" IsEnabled="{Binding IsNotBusy}" />
                    <Button Text="اعلان VPN و نمایش مصرف" Command="{Binding OpenAndroidNotificationSettingsCommand}" IsVisible="{Binding IsAndroid}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="اتصال" FontSize="19" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="اتصال مجدد هوشمند" VerticalOptions="Center" />
                            <Label Text="اگر سرور اول تأیید نشد، چند سرور سالم بعدی خودکار امتحان می‌شود." Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding AutoReconnect}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,120">
                        <Label Text="تعداد تلاش اتصال مجدد" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Keyboard="Numeric" Text="{Binding AutoReconnectAttempts}" />
                    </Grid>
                    <Label Text="{Binding ReleaseVersionText}" Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="موتور تست" FontSize="19" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,120"><Label Text="تعداد تست هم‌زمان" VerticalOptions="Center"/><Entry Grid.Column="1" Keyboard="Numeric" Text="{Binding Settings.TestConcurrency}"/></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Text="بررسی سریع قبل از تست اتصال" VerticalOptions="Center"/><Switch Grid.Column="1" IsToggled="{Binding Settings.FastTestMode}"/></Grid>
                    <Label Text="تعداد کمتر، مصرف حافظه و باتری را کاهش می‌دهد. در اینترنت کند، بررسی سریع را خاموش کن." Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="پاک‌سازی سرورهای قدیمی" FontSize="19" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="پاک‌سازی خودکار" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding Settings.AutoCleanupOldServers}" />
                    </Grid>
                    <Label Text="سرورهای با عمر حداقل ۷ روز، پس از ۳ تست ناموفق پیاپی حذف می‌شوند. برای جلوگیری از حذف هنگام قطعی اینترنت، یک تست سالم در ۱۵ دقیقهٔ اخیر لازم است. سرور فعال حذف نمی‌شود."
                           Style="{StaticResource SubtleLabel}" />
                    <Button Text="پاک‌سازی الان" Command="{Binding CleanupOldServersCommand}" IsEnabled="{Binding IsNotBusy}" />
                    <Label Text="{Binding CleanupSummary}" Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="داده جمعی سرورها" FontSize="19" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="استفاده از امتیاز کاربران" VerticalOptions="Center" />
                            <Label Text="یک فایل JSON عمومی می‌تواند سرورهای تست‌شده، Ping و نرخ موفقیت را برای رتبه‌بندی بهتر وارد کند." Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding Settings.EnableCommunityHealth}" VerticalOptions="Center" />
                    </Grid>
                    <Entry Text="{Binding Settings.CommunityHealthIndexUrl}" Placeholder="https://raw.githubusercontent.com/owner/repo/main/ranked-profiles.json" FlowDirection="LeftToRight" />
                    <Button Text="دریافت و اعمال داده جمعی" Command="{Binding RefreshCommunityHealthCommand}" />
                    <Label Text="{Binding CommunityHealthStatusMessage}" Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsWindows}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Windows" FontSize="19" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto"><Label Text="فعال‌سازی System Proxy پس از اتصال" VerticalOptions="Center"/><Switch Grid.Column="1" IsToggled="{Binding Settings.EnableSystemProxy}"/></Grid>
                    <Label Text="Xray Core" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Text="{Binding Settings.XrayPath}" Placeholder="xray.exe — خالی باشد تا خودکار دانلود شود" FlowDirection="LeftToRight" />
                        <Button Grid.Column="1" Text="Browse xray.exe" Command="{Binding BrowseXrayCommand}" />
                    </Grid>
                    <Label Text="اگر دانلود خودکار Xray به‌خاطر TLS/Proxy خطا داد، فایل xray.exe را دستی انتخاب کن." Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
            </Border>
            <Button Text="ذخیره تنظیمات" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
