<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SaeParTunnel.App.Pages.SettingsPage" Title="تنظیمات">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="900">
            <Label Text="تنظیمات" Style="{StaticResource TitleLabel}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="تجربه کاربری" FontSize="19" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="حالت سریع" VerticalOptions="Center" />
                            <Label Text="برای استفاده روزمره، مسیر اصلی را ساده و خلوت نگه می‌دارد." Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding QuickMode}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="اتصال مجدد هوشمند" VerticalOptions="Center" />
                            <Label Text="اگر سرور اول تأیید نشد، چند سرور سالم بعدی خودکار امتحان می‌شود." Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding AutoReconnect}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,120">
                        <Label Text="تعداد تلاش اتصال مجدد" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Keyboard="Numeric" Text="{Binding AutoReconnectAttempts}" />
                    </Grid>
                    <Label Text="{Binding ReleaseVersionText}" Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="موتور تست" FontSize="19" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,120"><Label Text="تعداد تست هم‌زمان" VerticalOptions="Center"/><Entry Grid.Column="1" Keyboard="Numeric" Text="{Binding Settings.TestConcurrency}"/></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Fast Test" VerticalOptions="Center"/><Switch Grid.Column="1" IsToggled="{Binding Settings.FastTestMode}"/></Grid>
                    <Label Text="Windows: 24–48 مناسب است. Android/iPhone: 4–8 برای مصرف باتری و RAM بهتر است." Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="منبع کانفیگ" FontSize="19" FontAttributes="Bold" />
                    <Entry Text="{Binding Settings.GitHubSubscriptionUrl}" FlowDirection="LeftToRight" />
                    <Label Text="منبع پیش‌فرض: Epodonios/v2ray-configs / All_Configs_Sub.txt" Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsWindows}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Windows" FontSize="19" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto"><Label Text="فعال‌سازی System Proxy پس از اتصال" VerticalOptions="Center"/><Switch Grid.Column="1" IsToggled="{Binding Settings.EnableSystemProxy}"/></Grid>
                    <Label Text="Xray Core" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Text="{Binding Settings.XrayPath}" Placeholder="xray.exe — خالی باشد تا خودکار دانلود شود" FlowDirection="LeftToRight" />
                        <Button Grid.Column="1" Text="Browse xray.exe" Command="{Binding BrowseXrayCommand}" />
                    </Grid>
                    <Label Text="اگر دانلود خودکار Xray به‌خاطر TLS/Proxy خطا داد، فایل xray.exe را دستی انتخاب کن." Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
            </Border>
            <Button Text="ذخیره تنظیمات" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
