<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SaeParTunnel.App.Pages.DashboardPage"
             Title="خانه">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="12" MaximumWidthRequest="900">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="SaePar Tunnel" Style="{StaticResource TitleLabel}" />
                    <Label Text="اتصال و وضعیت VPN" Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="1"
                                   IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Accent}"
                                   WidthRequest="34"
                                   HeightRequest="34"
                                   VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="7">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding BackendTitle}" FontAttributes="Bold" FontSize="17" />
                            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Accent}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding HealthyProfilesCountText}"
                               TextColor="{StaticResource Success}"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding BackendNote}" Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding CannotTunnel}" Stroke="{StaticResource Danger}">
                <VerticalStackLayout Spacing="5">
                    <Label Text="اتصال VPN روی این پلتفرم در دسترس نیست" TextColor="{StaticResource Danger}" FontAttributes="Bold" />
                    <Label Text="برای این پلتفرم هنوز Backend تونل واقعی فعال نشده است." Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="اتصال VPN" FontAttributes="Bold" FontSize="19" />
                            <Label Text="فقط کانفیگ‌های Full-Test سالم" Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding SelectedHealthyPingText}"
                               VerticalOptions="Center"
                               TextColor="{StaticResource Accent}"
                               FontAttributes="Bold"
                               FontSize="17" />
                    </Grid>

                    <Picker Title="سرور سالم"
                            ItemsSource="{Binding HealthyProfiles}"
                            SelectedItem="{Binding SelectedHealthyProfile}"
                            ItemDisplayBinding="{Binding PickerDisplayText}" />

                    <Label Text="{Binding HealthySelectionSummary}" Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Button Grid.Row="0" Grid.Column="0"
                                Text="اتصال"
                                Command="{Binding ConnectCommand}"
                                IsEnabled="{Binding CanStartConnection}"
                                Style="{StaticResource PrimaryButton}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Surface2}" />
                                    <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                    <Setter Property="FontAttributes" Value="None" />
                                    <Setter Property="Opacity" Value="0.65" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                    <Setter Property="TextColor" Value="#06221F" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="1"
                                Text="بهترین Ping"
                                Command="{Binding ConnectBestCommand}"
                                IsEnabled="{Binding CanStartConnection}" />
                        <Button Grid.Row="1" Grid.Column="0"
                                Text="تست همین سرور"
                                Command="{Binding TestHealthySelectionCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                        <Button Grid.Row="1" Grid.Column="1"
                                Text="قطع اتصال"
                                Command="{Binding DisconnectCommand}"
                                IsEnabled="{Binding CanStopConnection}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                                    <Setter Property="TextColor" Value="{StaticResource Surface0}" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Surface2}" />
                                    <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                    <Setter Property="FontAttributes" Value="None" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                    <Grid BackgroundColor="{StaticResource Surface2}" Padding="12" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <ActivityIndicator Grid.Column="0"
                                           IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           WidthRequest="22"
                                           HeightRequest="22"
                                           Color="{StaticResource Accent}" />
                        <Label Grid.Column="1"
                               Text="{Binding ConnectionStatusMessage}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                    </Grid>

                    <Button Text="تنظیمات VPN اندروید"
                            Command="{Binding OpenAndroidVpnSettingsCommand}"
                            IsVisible="{Binding IsAndroid}"
                            IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="دریافت، تست و مدیریت کانفیگ‌ها در تب کانفیگ‌ها انجام می‌شود."
                   Style="{StaticResource SubtleLabel}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
