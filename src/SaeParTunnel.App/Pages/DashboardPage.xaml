<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaeParTunnel.App.ViewModels"
             xmlns:models="clr-namespace:SaeParTunnel.Core.Models;assembly=SaeParTunnel.Core"
             x:Class="SaeParTunnel.App.Pages.DashboardPage"
             x:DataType="vm:MainViewModel" Title="اتصال">
    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="24" MaximumWidthRequest="480" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="4">
                <Label Text="SaePar" FontSize="26" FontAttributes="Bold" FlowDirection="LeftToRight" HorizontalTextAlignment="Center" />
                <Label Text="ساده وصل شو" Style="{StaticResource SubtleLabel}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Padding="24" StrokeShape="RoundRectangle 24">
                <VerticalStackLayout Spacing="20">
                    <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0" StrokeShape="RoundRectangle 32"
                            BackgroundColor="{StaticResource Surface2}" HorizontalOptions="Center">
                        <Label Text="○" FontSize="36" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               TextColor="{StaticResource TextSecondary}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Text" Value="✓" />
                                    <Setter Property="TextColor" Value="{StaticResource Success}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Label Text="{Binding HomeConnectionTitle}" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding HomeHint}" Style="{StaticResource SubtleLabel}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}" HeightRequest="24" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasHomeServers}">
                        <Label Text="سرور" Style="{StaticResource SubtleLabel}" />
                        <Picker Title="انتخاب سرور" ItemsSource="{Binding HealthyProfiles}"
                                SelectedItem="{Binding SelectedHealthyProfile}" IsEnabled="{Binding CanSearchServers}"
                                ItemDisplayBinding="{Binding DisplayName, x:DataType=models:ConfigProfile}"
                                SemanticProperties.Description="انتخاب سرور برای اتصال" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Button Text="{Binding PingButtonText}" Command="{Binding PingSelectedServerCommand}"
                                    IsEnabled="{Binding CanPingSelectedServer}" BackgroundColor="Transparent"
                                    TextColor="{StaticResource Accent}" Padding="0,8" HorizontalOptions="Start"
                                    SemanticProperties.Description="اندازه‌گیری دوباره پینگ سرور انتخاب‌شده" />
                            <Label Grid.Column="1" Text="{Binding SelectedHealthyPingText}" FontSize="18" FontAttributes="Bold"
                                   FlowDirection="LeftToRight" TextColor="{StaticResource Accent}" />
                        </Grid>
                        <Label Text="{Binding PingFeedback}" IsVisible="{Binding HasPingFeedback}" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>

                    <Button Text="اتصال" Command="{Binding ConnectCommand}" IsVisible="{Binding ShowHomeConnectAction}"
                            IsEnabled="{Binding CanConnectHome}" HeightRequest="56" CornerRadius="16" Style="{StaticResource PrimaryButton}" />
                    <Button Text="قطع اتصال" Command="{Binding DisconnectCommand}" IsVisible="{Binding ShowDisconnectAction}"
                            IsEnabled="{Binding CanStopConnection}" HeightRequest="56" CornerRadius="16" Style="{StaticResource DangerButton}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowConnectAction}">
                <Button Text="{Binding SearchServersLabel}" Command="{Binding FindServersCommand}" IsEnabled="{Binding CanSearchServers}"
                        HeightRequest="52" CornerRadius="16">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding HasHomeServers}" Value="False">
                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                            <Setter Property="TextColor" Value="#06221F" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsTesting}">
                    <ProgressBar Progress="{Binding ProgressFraction}" ProgressColor="{StaticResource Accent}" />
                    <Label Text="{Binding HomeSearchProgress}" Style="{StaticResource SubtleLabel}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Button Text="توقف جست‌وجو" Command="{Binding CancelTestCommand}" IsVisible="{Binding CanCancelHomeSearch}" BackgroundColor="Transparent" />
                <Label Text="۵ سرور سالم پیدا می‌کنیم؛ بهترین گزینه انتخاب می‌شود."
                       IsVisible="{Binding IsDisconnected}" Style="{StaticResource SubtleLabel}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Label Text="منابع و گزینه‌های بیشتر در تنظیمات پیشرفته"
                   Style="{StaticResource SubtleLabel}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
