<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SaeParTunnel.App.Pages.DashboardPage"
             Title="خانه">
    <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="18" Spacing="12" MaximumWidthRequest="900">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="SaePar Tunnel" Style="{StaticResource TitleLabel}" />
                    <Label Text="اتصال و وضعیت VPN" Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="1"
                                   IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Accent}"
                                   WidthRequest="34"
                                   HeightRequest="34"
                                   VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="7">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding BackendTitle}" FontAttributes="Bold" FontSize="17" />
                            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Accent}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding HealthyProfilesCountText}"
                               TextColor="{StaticResource Success}"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding BackendNote}" Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding CannotTunnel}" Stroke="{StaticResource Danger}">
                <VerticalStackLayout Spacing="5">
                    <Label Text="اتصال VPN روی این پلتفرم در دسترس نیست" TextColor="{StaticResource Danger}" FontAttributes="Bold" />
                    <Label Text="برای این پلتفرم هنوز Backend تونل واقعی فعال نشده است." Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="اتصال VPN" FontAttributes="Bold" FontSize="19" />
                            <Label Text="فقط کانفیگ‌های Full-Test سالم" Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                Padding="10,6"
                                BackgroundColor="{StaticResource Surface2}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#143627" />
                                    <Setter Property="Stroke" Value="{StaticResource Success}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsConnectionBusy}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#352A12" />
                                    <Setter Property="Stroke" Value="{StaticResource Warning}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding ConnectionBadgeText}"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontAttributes="Bold"
                                   FontSize="13">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsConnectionBusy}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Warning}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>

                    <Picker Title="سرور سالم"
                            ItemsSource="{Binding HealthyProfiles}"
                            SelectedItem="{Binding SelectedHealthyProfile}"
                            ItemDisplayBinding="{Binding PickerDisplayText}"
                            IsEnabled="{Binding CanStartConnection}" />

                    <Label Text="{Binding HealthySelectionSummary}" Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />

                    <VerticalStackLayout Spacing="8">
                        <Button Text="اتصال"
                                Command="{Binding ConnectCommand}"
                                IsVisible="{Binding ShowConnectAction}"
                                IsEnabled="{Binding CanStartConnection}"
                                Style="{StaticResource PrimaryButton}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsConnectionBusy}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Surface2}" />
                                    <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                    <Setter Property="FontAttributes" Value="None" />
                                    <Setter Property="Opacity" Value="0.65" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="قطع اتصال"
                                Command="{Binding DisconnectCommand}"
                                IsVisible="{Binding ShowDisconnectAction}"
                                IsEnabled="{Binding CanStopConnection}"
                                BackgroundColor="{StaticResource Danger}"
                                TextColor="{StaticResource Surface0}"
                                FontAttributes="Bold">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsConnectionBusy}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Surface2}" />
                                    <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                    <Setter Property="FontAttributes" Value="None" />
                                    <Setter Property="Opacity" Value="0.65" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding ShowConnectionTools}">
                            <Button Grid.Column="0"
                                    Text="بهترین Ping"
                                    Command="{Binding ConnectBestCommand}"
                                    IsEnabled="{Binding CanStartConnection}" />
                            <Button Grid.Column="1"
                                    Text="تست همین سرور"
                                    Command="{Binding TestHealthySelectionCommand}"
                                    IsEnabled="{Binding IsNotBusy}" />
                        </Grid>
                    </VerticalStackLayout>

                    <Grid BackgroundColor="{StaticResource Surface2}" Padding="12" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <ActivityIndicator Grid.Column="0"
                                           IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           WidthRequest="22"
                                           HeightRequest="22"
                                           Color="{StaticResource Accent}" />
                        <Label Grid.Column="1"
                               Text="{Binding ConnectionStatusMessage}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                    </Grid>

                    <Button Text="تنظیمات VPN اندروید"
                            Command="{Binding OpenAndroidVpnSettingsCommand}"
                            IsVisible="{Binding IsAndroid}"
                            IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="دریافت، تست و مدیریت کانفیگ‌ها در تب کانفیگ‌ها انجام می‌شود."
                   Style="{StaticResource SubtleLabel}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>

    <Border Grid.Row="1"
            BackgroundColor="{StaticResource Surface1}"
            Stroke="{StaticResource Border}"
            StrokeThickness="1"
            Padding="12,10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" MaximumWidthRequest="900">
            <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                <Label Text="{Binding ConnectionBadgeText}" FontAttributes="Bold" />
                <Label Text="{Binding ConnectionStatusMessage}"
                       Style="{StaticResource SubtleLabel}"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="اتصال"
                    Command="{Binding ConnectCommand}"
                    IsVisible="{Binding ShowConnectAction}"
                    IsEnabled="{Binding CanStartConnection}"
                    Style="{StaticResource PrimaryButton}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsConnectionBusy}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Surface2}" />
                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                        <Setter Property="FontAttributes" Value="None" />
                        <Setter Property="Opacity" Value="0.65" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1"
                    Text="قطع اتصال"
                    Command="{Binding DisconnectCommand}"
                    IsVisible="{Binding ShowDisconnectAction}"
                    IsEnabled="{Binding CanStopConnection}"
                    BackgroundColor="{StaticResource Danger}"
                    TextColor="{StaticResource Surface0}"
                    FontAttributes="Bold">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsConnectionBusy}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Surface2}" />
                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                        <Setter Property="FontAttributes" Value="None" />
                        <Setter Property="Opacity" Value="0.65" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>
    </Border>
    </Grid>
</ContentPage>
