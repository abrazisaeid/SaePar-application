<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(SaeParTargetFrameworks)' != ''">$(SaeParTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SaeParTunnel.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationTitle>SaePar Tunnel</ApplicationTitle>
    <ApplicationId>com.saepar.tunnel</ApplicationId>
    <ApplicationDisplayVersion>2.0.29</ApplicationDisplayVersion>
    <ApplicationVersion>49</ApplicationVersion>
    <Version>2.0.29</Version>
    <PackageVersion>2.0.29</PackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(SaeParProbeDiagnostics)' == 'true'">
    <DefineConstants>$(DefineConstants);SAEPAR_PROBE_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
    <CodesignKey Condition="'$(IosSigningKey)' != ''">$(IosSigningKey)</CodesignKey>
    <CodesignKeychain Condition="'$(IosSigningKeychain)' != ''">$(IosSigningKeychain)</CodesignKeychain>
    <CodesignProvision Condition="'$(IosAppProvisioningProfile)' != ''">$(IosAppProvisioningProfile)</CodesignProvision>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- During development run the Windows target unpackaged. This matches the
         Visual Studio MAUI Project launch profile and avoids MSIX deployment
         requirements. Packaging can be re-enabled for release builds later. -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the glyph transparent for Android's monochrome layer. Android
         masks the full-bleed background; the foreground stays in the safe area. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1220">
      <ForegroundScale Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">0.78</ForegroundScale>
    </MauiIcon>
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B1220" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- AAR-to-C# bindings must live in a real Android binding project.
         A ProjectReference then brings both the managed binding assembly and
         its Java/native AAR dependencies into the Android app. -->
    <ProjectReference Include="..\SaeParTunnel.AndroidBinding\SaeParTunnel.AndroidBinding.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <ProjectReference Include="..\SaeParTunnel.iOSBinding\SaeParTunnel.iOSBinding.csproj" />
    <ProjectReference Include="..\SaeParTunnel.iOS.Extension\SaeParTunnel.iOS.Extension.csproj">
      <IsAppExtension>true</IsAppExtension>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <ProjectReference Include="..\SaeParTunnel.Core\SaeParTunnel.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Content Include="..\SaeParTunnel.Core\Data\Iran\LICENSE-iran-hosted-domains.txt" Link="ThirdParty\IranRouting\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\SaeParTunnel.Core\Data\Iran\SOURCES.json" Link="ThirdParty\IranRouting\SOURCES.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
