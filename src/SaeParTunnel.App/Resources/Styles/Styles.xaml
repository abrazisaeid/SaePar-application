<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{StaticResource Surface0}" /><Setter Property="FlowDirection" Value="RightToLeft" /></Style>
    <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource TextPrimary}" /><Setter Property="FontSize" Value="14" /></Style>
    <Style TargetType="Entry"><Setter Property="TextColor" Value="{StaticResource TextPrimary}" /><Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" /><Setter Property="BackgroundColor" Value="{StaticResource Surface2}" /></Style>
    <Style TargetType="SearchBar"><Setter Property="TextColor" Value="{StaticResource TextPrimary}" /><Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" /><Setter Property="BackgroundColor" Value="{StaticResource Surface2}" /></Style>
    <Style TargetType="Picker"><Setter Property="TextColor" Value="{StaticResource TextPrimary}" /><Setter Property="BackgroundColor" Value="{StaticResource Surface2}" /></Style>
    <Style TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource Surface2}" /><Setter Property="TextColor" Value="{StaticResource TextPrimary}" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="14,10" /></Style>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource Accent}" /><Setter Property="TextColor" Value="#06221F" /><Setter Property="FontAttributes" Value="Bold" /></Style>
    <Style x:Key="DangerButton" TargetType="Button"><Setter Property="BackgroundColor" Value="#4A1D2A" /><Setter Property="TextColor" Value="#FFD8E0" /></Style>
    <Style x:Key="TitleLabel" TargetType="Label"><Setter Property="FontSize" Value="28" /><Setter Property="FontAttributes" Value="Bold" /></Style>
    <Style x:Key="SubtleLabel" TargetType="Label"><Setter Property="TextColor" Value="{StaticResource TextSecondary}" /><Setter Property="FontSize" Value="13" /></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="BackgroundColor" Value="{StaticResource Surface1}" /><Setter Property="Stroke" Value="{StaticResource Border}" /><Setter Property="StrokeThickness" Value="1" /><Setter Property="Padding" Value="16" /><Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="16" /></Setter.Value></Setter></Style>
</ResourceDictionary>
