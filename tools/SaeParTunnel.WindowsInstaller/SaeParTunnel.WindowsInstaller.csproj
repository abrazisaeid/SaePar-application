<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SaeParTunnel.Setup</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PackageZipPath)" LogicalName="Payload.windows.zip" Condition="'$(PackageZipPath)' != ''" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PayloadSha256</_Parameter1>
      <_Parameter2>$(PackageSha256)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="RequireWindowsPackage" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(PackageZipPath)') or '$(PackageSha256)' == ''" Text="Provide PackageZipPath and PackageSha256 for the verified Windows ZIP." />
  </Target>
</Project>
